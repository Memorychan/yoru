DATABASE_URL=postgresql://yoru:yoru_local_only@127.0.0.1:5432/yoru?connection_limit=5&pool_timeout=15
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
GATEWAY_INTERNAL_URL=http://127.0.0.1:4001
GATEWAY_PORT=4001
PORT=4000
NODE_ENV=development
# Generate with npm run setup:env. Never change without rewrapping existing keys.
MASTER_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DATA_DIR=./data
PYTHON_BIN=python
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAX_UPLOAD_GB=10
# Optional: set true to load artwork-only catalog entries during db:seed.
SEED_SHOWCASE=true
# Encrypted database + uploaded artwork backups. Use one active installation per bucket.
BACKUP_HF_BUCKET=
BACKUP_HF_TOKEN=
BACKUP_INTERVAL_SECONDS=900

# Google OAuth credentials for private Drive imports
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
