{
  "name": "yoru",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n web,api,media,worker,backup -c cyan,magenta,green,yellow \"next dev\" \"npm run dev:api\" \"npm run dev:gateway\" \"npm run dev:worker\" \"node scripts/hf-backup.cjs daemon\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/main.ts",
    "dev:worker": "tsx watch --tsconfig tsconfig.server.json server/worker.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --tsconfig tsconfig.server.json prisma/seed.ts",
    "start:web": "next start",
    "start:api": "node dist/server/main.js",
    "start:worker": "node dist/server/worker.js",
    "setup:env": "node scripts/setup-env.mjs",
    "dev:gateway": "tsx watch --tsconfig tsconfig.server.json server/gateway.ts",
    "start:gateway": "node dist/server/gateway.js",
    "format": "prettier --write app components lib server scripts prisma/seed.ts",
    "predev": "node scripts/local-services.cjs",
    "local:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "local:start": "node scripts/local-services.cjs",
    "db:migrate-local": "node scripts/migrate-local.cjs",
    "db:backup": "node scripts/hf-backup.cjs backup",
    "db:restore": "node scripts/hf-backup.cjs restore",
    "start:render": "node scripts/start-render.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "hls.js": "^1.6.13",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "next": "^15.5.12",
    "otpauth": "^9.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  }
}